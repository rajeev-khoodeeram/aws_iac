    {
      "module": "module.scp",
      "mode": "managed",
      "type": "aws_organizations_policy",
      "name": "deny_cloudtrail_changes",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:organizations::651015497425:policy/o-tz21r6aep6/service_control_policy/p-eupwpyhs",
            "content": "{\r\n  \"Version\": \"2012-10-17\",\r\n  \"Statement\": [\r\n    {\r\n      \"Sid\": \"DenyCloudTrailChanges\",\r\n      \"Effect\": \"Deny\",\r\n      \"Action\": [\r\n        \"cloudtrail:StopLogging\",\r\n        \"cloudtrail:DeleteTrail\",\r\n        \"cloudtrail:UpdateTrail\",\r\n        \"cloudtrail:PutEventSelectors\",\r\n        \"cloudtrail:PutInsightSelectors\"\r\n      ],\r\n      \"Resource\": \"*\"\r\n    }\r\n  ]\r\n}",
            "description": "Prevent workloads from disabling or modifying CloudTrail",
            "id": "p-eupwpyhs",
            "name": "Deny-CloudTrail-Changes",
            "skip_destroy": null,
            "tags": null,
            "tags_all": {},
            "type": "SERVICE_CONTROL_POLICY"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0,
          "private": "bnVsbA=="
        }
      ]
    },
